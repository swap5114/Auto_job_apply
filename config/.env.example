SORSA_API_KEY=
HUNTER_API_KEY=
APOLLO_API_KEY=
ANTHROPIC_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GOOGLE_SHEET_ID=
FIRECRAWL_API_KEY=

# Sandbox / demo builder (see sandbox/config.py)
KIRO_API_KEY=
VERCEL_TOKEN=
RENDER_API_KEY=

# Single-user bootstrap (see db/current_user.py) -- stands in for Firebase
# Auth until Phase 3. Both optional; sensible defaults are used if unset.
LOCAL_USER_FIREBASE_UID=
LOCAL_USER_EMAIL=

# Phase 3: Firebase Auth (see api/auth.py) -- verifies per-request ID
# tokens from the frontend's Google Sign-In. Path to a Firebase service
# account JSON key (gitignored, like config/gmail_credentials.json). If
# unset, falls back to Application Default Credentials (e.g. Cloud Run's
# attached service account in production).
FIREBASE_SERVICE_ACCOUNT_PATH=

# Comma-separated list of origins allowed to call this API (CORS). Falls
# back to http://localhost:3000 if unset. Add the deployed frontend's
# origin here once it exists -- no code change needed.
# e.g. ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com
ALLOWED_ORIGINS=

# Phase 4.4: Cloud Tasks + worker. USE_CLOUD_TASKS=false (default) runs
# pipeline tasks in-process on a background thread (api/tasks.py) --
# no GCP dependency needed for local dev / docker compose. Set
# USE_CLOUD_TASKS=true only once the rest of these are configured and a
# real Cloud Tasks queue exists.
USE_CLOUD_TASKS=false
GCP_PROJECT_ID=
GCP_TASKS_LOCATION=us-central1
CLOUD_TASKS_QUEUE=autoapply-pipeline
# Base URL of the deployed worker service (Cloud Run), e.g.
# https://autoapply-worker-xxxx-uc.a.run.app -- api/tasks.py posts tasks to
# WORKER_URL + "/tasks/run".
WORKER_URL=
# Service account Cloud Tasks uses to attach a verifiable OIDC ID token to
# each push request. Leave unset in local dev (falls back to the shared
# secret below).
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=
# Shared-secret header worker/main.py's /tasks/run checks as a stopgap
# auth mechanism until full OIDC token verification is added -- see that
# module's docstring. Set to a long random value; required whenever
# USE_CLOUD_TASKS=true (the worker refuses all requests without it).
WORKER_SHARED_SECRET=

# --- v1 Task 5: per-user Gmail OAuth (web flow) ---
# Each signed-in user connects their OWN Gmail via browser consent; we store
# only an ENCRYPTED refresh token. Requires an OAuth *Web application* client
# (distinct from the old Desktop client config/gmail_credentials.json) in
# Google Cloud Console, with the redirect URI below added to its allowed list.
# GMAIL_CLIENT_ID / GMAIL_CLIENT_SECRET above are reused for this web client.
#
# Full backend URL Google redirects to after consent, e.g.
#   http://localhost:8000/api/gmail/callback  (local)
#   https://api.example.com/api/gmail/callback (prod)
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8000/api/gmail/callback
# Where the callback sends the browser back to after connecting (the frontend).
FRONTEND_URL=http://localhost:3000
# Fernet key used to encrypt stored refresh tokens AND sign the OAuth state
# param. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it secret and stable -- rotating it invalidates all stored Gmail tokens.
GMAIL_TOKEN_ENC_KEY=

# --- v1 Task 14: outgoing-email compliance (CAN-SPAM) ---
# Appended to every outgoing message body. The opt-out note is always included;
# a physical mailing address is appended only if COMPLIANCE_ADDRESS is set
# (recommended for real sending -- CAN-SPAM requires a valid postal address).
COMPLIANCE_UNSUBSCRIBE_NOTE=P.S. Not the right time? Just reply and I won't follow up.
COMPLIANCE_ADDRESS=

# --- 1-Click Provider OAuth Integration ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/vercel/callback

