SORSA_API_KEY=
HUNTER_API_KEY=
APOLLO_API_KEY=
ANTHROPIC_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GOOGLE_SHEET_ID=
FIRECRAWL_API_KEY=

# --- Auto-built demo projects (Option 2: Sandbox verification + deploy) ---
# Vercel access token (Account Settings -> Tokens). Used for BOTH the Sandbox
# build-verify step and the Deployments API. Required only when DEMO_BUILD_ENABLED=true.
VERCEL_TOKEN=
# Optional: Vercel OIDC token for Sandbox auth. If unset, VERCEL_TOKEN is used.
VERCEL_OIDC_TOKEN=
# Master switch. Defaults to false so the pipeline behaves exactly as before
# until you explicitly opt in. Set to true to build+deploy demos.
DEMO_BUILD_ENABLED=false
# Which llm_client backend generates the demo app code. Blank = use the global
# MODEL_BACKEND default. Options: claude | gemini | ollama.
DEMO_CODEGEN_BACKEND=
# Max generate->build->fix attempts before giving up (main cost lever).
DEMO_MAX_RETRIES=2
# Max demos actually built per feed/batch run (per-run cost cap).
DEMO_MAX_PER_RUN=5
# Prefix for the per-lead Vercel project name (e.g. "demo-acme-corp").
DEMO_PROJECT_PREFIX=demo-
